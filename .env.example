# PostgreSQL connection string from Supabase (URI / Connection Pooler)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# (Optional) Local PostgreSQL connection string if running sync scripts
LOCAL_DATABASE_URL=postgresql://postgres:your-local-password@localhost:5432/infobash

# Password organizers use to log in at /admin
ADMIN_PASSWORD=your-admin-password

# Random 32+ character strings used to sign login session cookies
ADMIN_SESSION_SECRET=3b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c
CAPTAIN_SESSION_SECRET=7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a

# Google OAuth Credentials for Captain Authentication (from Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Public URL of this app — used as the OAuth redirect_uri fallback.
# Set to your production domain (no trailing slash).
# Also add this URL as an Authorized Redirect URI in Google Cloud Console.
NEXT_PUBLIC_APP_URL=https://infobash2026.vercel.app

# Cloudinary Credentials for Team Logo Storage (Optional)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=bifpbzls
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@bifpbzls

