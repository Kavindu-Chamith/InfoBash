# PostgreSQL connection string, e.g. from Neon, Supabase, Railway, or your own server.
DATABASE_URL=postgresql://user:password@host:5432/infobash

# Password organizers use to log in at /admin to view and export registrations.
ADMIN_PASSWORD=change-this-password

# Random long string used to sign the admin login session cookie.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=change-this-to-a-random-secret

# Random long string used to sign team captains' login session cookie.
# Generate one with: openssl rand -hex 32
CAPTAIN_SESSION_SECRET=change-this-to-a-random-secret

# Google OAuth Credentials for Captain Authentication (from Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Google Drive Folder Credentials for Direct Team Logo Uploads
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
